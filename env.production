APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:24L98IPC+69bwwTlCWcaWSzeXJZO9Z3wjpXAexrQtG4=
APP_DEBUG=true
APP_URL=https://dev.medovf2h.beget.tech/

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=ledger_craft_db
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
# Локально (docker compose) письма падают в Mailpit: http://localhost:8025.
# На контурах (dev/prod) — реальный SMTP beget:
#   MAIL_HOST=smtp.beget.com
#   MAIL_PORT=465
#   MAIL_ENCRYPTION=ssl
#   MAIL_USERNAME=no-reply@ledgercraft.ru
#   MAIL_PASSWORD=<пароль ящика>        # только в .env (640), не в git и не в отчётах
#   MAIL_FROM_ADDRESS=no-reply@ledgercraft.ru
#   MAIL_REPLY_TO_ADDRESS=<живой ящик>  # ответы пользователей
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ledgercraft.ru"
MAIL_FROM_NAME="Ledger Craft"
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Ledger Craft"

# Ссылки из писем: https-bridge бэкенда → Android-приложение (веб-версии нет).
# Схема совпадает с intent-filter в манифесте APK, пути — с config/app-links.php.
APP_DEEP_LINK_SCHEME=ledgercraft
APP_LINKS_VERIFICATION_EXPIRE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_URL="https://dev.medovf2h.beget.tech"

# Обратная связь: отчёты «Сообщить об ошибке» (Фаза 14). Токен выгрузки — свой на
# каждый контур (dev/prod); на клиенте тот же токен лежит в .env.local как
# FEEDBACK_PULL_TOKEN. Пусто = выгрузка выключена (приём отчётов работает).
FEEDBACK_PULL_TOKEN=
FEEDBACK_RATE_LIMIT_PER_HOUR=10

