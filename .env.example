APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@ledgercraft.local"
MAIL_FROM_NAME="Ledger Craft"
# Ответы пользователей уводим на живой ящик, сами письма уходят с no-reply@.
# Пусто — заголовок Reply-To не добавляется.
MAIL_REPLY_TO_ADDRESS=
MAIL_REPLY_TO_NAME="Ledger Craft"

# Ссылки из писем ведут на https-bridge бэкенда и уводят в Android-приложение
# (веб-версии пока нет). Схема должна совпадать с intent-filter в манифесте APK
# (`src-capacitor/android/app/src/main/AndroidManifest.xml`), а пути — с
# `config/app-links.php`.
APP_DEEP_LINK_SCHEME=ledgercraft
APP_LINKS_VERIFICATION_EXPIRE=60

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Обратная связь: отчёты «Сообщить об ошибке» (Фаза 14, решение D7).
# Отдельный pull-токен выгрузки отчётов (разработчик/агент, ручка GET /api/feedback).
# Пока пусто — выгрузка выключена (503), приём отчётов при этом работает.
# Тот же токен прописывается на клиенте (ledger-craft-offline-first-PS/.env.local)
# как FEEDBACK_PULL_TOKEN.
FEEDBACK_PULL_TOKEN=
FEEDBACK_RATE_LIMIT_PER_HOUR=10
# FEEDBACK_EXPORT_DIR=/var/www/storage/app/feedback
